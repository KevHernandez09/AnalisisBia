// -------------------------------------------------------------
// GENERATOR & DATASOURCE
// -------------------------------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// MODELO DE USUARIO + AUDITORÍA DE SESIONES
// -------------------------------------------------------------
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?

  // Relación 1:N con sesiones
  sessions     UserSession[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UserSession {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  loginAt   DateTime @default(now())
  logoutAt  DateTime?     // null si no ha salido

  ip        String?
  userAgent String?
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------
enum Prioridad {
  Alta
  Media
  Baja
}

// -------------------------------------------------------------
// PROCESOS CRÍTICOS
// -------------------------------------------------------------
model ProcesoCritico {
  id             String         @id @default(cuid())
  nombre         String
  descripcion    String
  entradas       String         @default("")
  salidas        String         @default("")
  partes         String         @default("")
  sincronizacion String         @default("")
  rto            String         @default("")
  mtpd           String         @default("")
  rpo            String         @default("")
  recursos       String         @default("")
  requisitos     String         @default("")
  descImpacto    String         @default("")
  prioridad      Prioridad

  areas          ProcesoArea[]
  impactos       ProcesoImpact[]

  subAreas       ProcesoSubarea[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// -------------------------------------------------------------
// ÁREAS, SUBÁREAS Y RELACIONES
// -------------------------------------------------------------
model Area {
  id          String           @id
  label       String           @unique

  usos        ProcesoArea[]
  subAreas    SubArea[]
  estrategias EstrategiaArea[]
}

model SubArea {
  id        String @id
  label     String @unique

  areaId    String
  area      Area   @relation(fields: [areaId], references: [id])

  procesos  ProcesoSubarea[] @relation("SubareaToProceso")
}

model ProcesoArea {
  procesoId String
  areaId    String

  proceso ProcesoCritico @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  area    Area           @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([procesoId, areaId])
}

model ProcesoSubarea {
  procesoId String
  subareaId String

  proceso ProcesoCritico @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  subarea SubArea        @relation("SubareaToProceso", fields: [subareaId], references: [id], onDelete: Cascade)

  @@id([procesoId, subareaId])
}

// -------------------------------------------------------------
// IMPACTOS
// -------------------------------------------------------------
model ImpactType {
  id   Int             @id @default(autoincrement())
  name String          @unique
  usos ProcesoImpact[]
}

model ProcesoImpact {
  procesoId    String
  impactTypeId Int

  proceso    ProcesoCritico @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  impactType ImpactType     @relation(fields: [impactTypeId], references: [id], onDelete: Cascade)

  @@id([procesoId, impactTypeId])
}

// -------------------------------------------------------------
// ESTRATEGIAS
// -------------------------------------------------------------
model Estrategia {
  id                 String       @id @default(cuid())

  nombreProceso      String
  descripcionProceso String
  tipo               String

  soluciones        String
  recursos          String        @default("")
  responsabilidades String        @default("")
  roles             String        @default("")
  estructura        String        @default("")
  actividades       String        @default("")
  frecuencias       String        @default("")
  resultados        String        @default("")
  monitoreo         String        @default("")

  areas             EstrategiaArea[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model EstrategiaArea {
  estrategiaId String
  areaId       String

  estrategia Estrategia @relation(fields: [estrategiaId], references: [id], onDelete: Cascade)
  area       Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([estrategiaId, areaId])
}

// -------------------------------------------------------------
// PLANES Y ACCIONES
// -------------------------------------------------------------
model Plan {
  id          String       @id @default(cuid())
  nombre      String
  descripcion String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  acciones    PlanAccion[]
}

model PlanAccion {
  id              String   @id @default(cuid())

  planId          String
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  acciones        String
  marcoLegalidad  String
  afectacionMarco String
  coordinacion    String
  areaContacto    String
  requerimientos  String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
