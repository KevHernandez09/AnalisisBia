generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
enum Prioridad {
  Alta
  Media
  Baja
}

model ProcesoCritico {
  id             String    @id @default(cuid())
  nombre         String
  descripcion    String
  entradas       String    @default("")
  salidas        String    @default("")
  partes         String    @default("")
  sincronizacion String    @default("")
  rto            String    @default("")
  mtpd           String    @default("")
  rpo            String    @default("")
  recursos       String    @default("")
  requisitos     String    @default("")
  descImpacto    String    @default("")
  prioridad      Prioridad

  areas    ProcesoArea[]
  impactos ProcesoImpact[]

  subAreas ProcesoSubarea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id          String           @id // "1".."19"
  label       String           @unique // nombre del departamento
  usos        ProcesoArea[]
  subAreas    SubArea[] // 🔹 subáreas del departamento
  estrategias EstrategiaArea[]
}

model ImpactType {
  id   Int             @id @default(autoincrement())
  name String          @unique
  usos ProcesoImpact[]
}

model ProcesoArea {
  procesoId String
  areaId    String

  proceso ProcesoCritico @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  area    Area           @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([procesoId, areaId])
}

model ProcesoImpact {
  procesoId    String
  impactTypeId Int

  proceso    ProcesoCritico @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  impactType ImpactType     @relation(fields: [impactTypeId], references: [id], onDelete: Cascade)

  @@id([procesoId, impactTypeId])
}

model SubArea {
  id     String @id
  label  String @unique
  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  procesos ProcesoSubarea[] @relation("SubareaToProceso")
}

model ProcesoSubarea {
  procesoId String
  subareaId String

  proceso ProcesoCritico @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  subarea SubArea @relation("SubareaToProceso", fields: [subareaId], references: [id], onDelete: Cascade)

  @@id([procesoId, subareaId])
}

model Estrategia {
  id String @id @default(cuid())

  // Lo que viene del formulario:
  nombreProceso      String
  descripcionProceso String
  tipo               String // ej.: "Estrategias de prevención"

  soluciones        String
  recursos          String @default("")
  responsabilidades String @default("")
  roles             String @default("")
  estructura        String @default("")
  actividades       String @default("")
  frecuencias       String @default("")
  resultados        String @default("")
  monitoreo         String @default("")

  // Relación N:M con Area (departamentos del combo)
  areas EstrategiaArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EstrategiaArea {
  estrategiaId String
  areaId       String

  estrategia Estrategia @relation(fields: [estrategiaId], references: [id], onDelete: Cascade)
  area       Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([estrategiaId, areaId])
}
